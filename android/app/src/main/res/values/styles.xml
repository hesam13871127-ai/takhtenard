<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App name shown under the launcher icon. -->
    <string name="app_name">تخته نرد</string>

    <!-- Splash / launcher background, matching the in-app dark wood tone. -->
    <color name="splash_background">#241612</color>

    <!-- Adaptive icon background color. -->
    <color name="ic_launcher_background">#241612</color>

    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
